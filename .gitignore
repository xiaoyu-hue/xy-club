# 依赖
node_modules/

# 站点数据（含管理密码，首次启动会自动从 defaults.js 生成）
data/db.json
data/*.tmp

# 后台上传的图片
public/uploads/*
!public/uploads/.gitkeep

# 静态快照（由 scripts/build-static.js 生成，属构建产物）
public/content.json

# 配置文件解析失败时自动留存的现场
data/*.corrupt-*

# Playwright 产物（E2E 为可选工具，产物不入库）
test-results/
playwright-report/
blob-report/
.playwright/

# 日志与系统文件
*.log
.DS_Store

# 本地发布辅助脚本（含个人使用说明，不入库）
push-v1.8.0.sh

# 内部工作文档（审查报告/计划方案/工作总结，按 GLOBAL.md 规则不入库）
docs/IMAGE-AUDIT.md
